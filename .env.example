# Numero oficial de WhatsApp en formato E.164, solo digitos con codigo de
# pais, sin "+". Lo entrega Andri. Mientras no exista, deja esta variable
# vacia: los CTA y el FAB deben caer en su estado Disabled/oculto.
PUBLIC_WHATSAPP_E164=

# Conexion al panel administrativo: el sitio lee sus datos (WhatsApp, horario,
# mapa, redes, aviso) de business_settings EN EL BUILD. Sin prefijo PUBLIC_ para
# que Astro no las meta al navegador. Clave publicable (anon), nunca service_role.
# Si faltan, el sitio usa PUBLIC_WHATSAPP_E164 y textos neutros.
SUPABASE_URL=
SUPABASE_ANON_KEY=
