---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import TrustPolicy from '../components/TrustPolicy.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
---

<BaseLayout
  title="Imprenta Escalante — Cotiza tus impresos por WhatsApp"
  description="Lonas, viniles, papelería comercial y promocionales para menudeo y mayoreo. Cotiza por WhatsApp y da seguimiento a tu pedido."
>
  <Header />
  <main>
    <Hero />
    <ServicesGrid />
    <TrustPolicy />
  </main>
  <Footer />
  <WhatsAppFab />
</BaseLayout>
