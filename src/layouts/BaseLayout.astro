---
/**
 * Tipografia autohospedada (Fase 2.5 §1.3). Antes se cargaba desde
 * fonts.googleapis.com, lo que costaba dos conexiones a un tercero antes de
 * pintar texto con la fuente final y enviaba la IP de cada visitante a Google.
 * Solo el subconjunto latin y solo los pesos EN USO: Anton 400 para display,
 * Barlow 400 y 600 para cuerpo. @fontsource ya declara font-display: swap.
 *
 * Barlow 700 se retiro: ningun componente usa font-bold, asi que solo sumaba
 * 22 KB al bundle sin llegar a descargarse nunca.
 */
import '@fontsource/anton/latin-400.css';
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-600.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /**
   * Imagen de vista previa social, 1200x630 (Fase 2 §3.5). Mientras Andri no
   * entregue el asset de marca, se omite: es preferible no declarar og:image
   * a declarar una ruta que no existe, porque WhatsApp cachea el fallo.
   */
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;

/**
 * Astro.site sale de PUBLIC_SITE_URL (ver astro.config.mjs). Si no esta
 * definida, Astro.url apunta a localhost durante el build; se omite la URL
 * canonica antes que publicar una que apunte a la maquina de desarrollo.
 */
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon-256.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <title>{title}</title>

    {/* Vista previa social (Fase 2 §3.5) */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content="Imprenta Escalante" />
    {
      /* Los tres van juntos o no va ninguno: declarar width y height sin la
         imagen deja meta tags colgados, y un og:image relativo no lo resuelve
         ningun crawler — por eso depende de PUBLIC_SITE_URL (Astro.site). */
      ogImage && Astro.site && (
        <>
          <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta
      name="twitter:card"
      content={ogImage && Astro.site ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <slot />

    <script>
      import { initWhatsappBehavior } from '../lib/wa-cta-client';
      initWhatsappBehavior();
    </script>
  </body>
</html>
