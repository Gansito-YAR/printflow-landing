---
/**
 * Header publico (spec §8.1). Alturas 56px movil / 72px escritorio — NO TOCAR.
 * Superficie oscura de marca: la clase .surface-inverse redefine los tokens
 * de tinta, borde y foco para que todo lo de adentro siga cumpliendo AA.
 *
 * Fase 2.5 §2.2 — El CTA de WhatsApp del header se retiro. Competia con el
 * del hero: mismo texto, mismo naranja y ambos visibles en la misma pantalla,
 * lo que aplanaba la jerarquia. El enlace "Servicios" queda como la unica
 * accion del header y ahora se muestra tambien en movil, donde antes estaba
 * oculto y el header no ofrecia ninguna via de navegacion.
 *
 * El logo es PNG con transparencia extraido del material de la imprenta. Al
 * no llevar fondo propio, funciona igual sobre el header y el footer oscuros
 * (Fase 2.5 §3.4.7). El alt va vacio a proposito: el enlace ya lleva
 * aria-label, que gana sobre el contenido, y un alt con el mismo texto haria
 * que un lector de pantalla anunciara el nombre dos veces.
 *
 * Conserva el texto "Servicios" a proposito: el hero ya tiene un CTA
 * secundario "Ver servicios", y ambos son visibles a la vez en la primera
 * pantalla. Duplicar el texto reintroduciria la redundancia que este bloque
 * viene a eliminar.
 */
import { Image } from 'astro:assets';
import logo from '../assets/logo-imprenta-escalante.png';
import { CATEGORIAS } from '../data/catalogo';
---

<header class="surface-inverse border-b border-line-hairline bg-surface-inverse h-space-7 md:h-space-9">
  <div
    class="mx-auto flex h-full max-w-container items-center justify-between px-space-2 md:px-space-6"
  >
    <a
      href="/"
      aria-label="Imprenta Escalante — inicio"
      data-testid="logo-home-link"
      class="rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2"
    >
      <Image
        src={logo}
        alt=""
        width={800}
        height={165}
        loading="eager"
        class="h-6 w-auto md:h-8"
      />
    </a>

    <nav aria-label="Navegación principal" class="flex items-center gap-space-3">
      {/* Las cuatro categorias del catalogo, como en la maqueta aprobada.
          Se ocultan por debajo de lg: no entran en 56px de alto y la §8.1
          de Fase 1 prohibe el menu hamburguesa. En movil queda el enlace
          directo a Catalogo, que lleva al indice navegable. */}
      {
        CATEGORIAS.map((categoria) => (
          <a
            href={`#catalogo-${categoria.id}`}
            data-testid={`nav-${categoria.id}`}
            class="hidden items-center rounded-sm text-small font-semibold text-ink-strong underline-offset-4 transition-colors duration-fast hover:text-ink-brand lg:inline-flex"
          >
            {categoria.titulo}
          </a>
        ))
      }
      <a
        href="#catalogo"
        data-testid="nav-catalogo"
        class="inline-flex items-center rounded-sm text-small font-semibold text-ink-strong underline-offset-4 transition-colors duration-fast hover:text-ink-brand lg:hidden"
      >
        Catálogo
      </a>
      {/* Ancla interna al CTA del hero, no un quinto enlace a WhatsApp: el
          Bloque 2 de Fase 2.5 dejo la pagina en cuatro y asi se conserva. */}
      <a
        href="#inicio"
        data-testid="nav-cotizar"
        class="inline-flex h-10 items-center justify-center rounded-full bg-action-primary px-space-3 font-display text-small uppercase text-action-primary-text transition-colors duration-base hover:bg-action-primary-hover focus-visible:outline-2 focus-visible:outline-offset-2"
      >
        Cotizar
      </a>
    </nav>
  </div>
</header>
