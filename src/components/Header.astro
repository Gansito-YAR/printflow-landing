---
/**
 * Header publico (spec §8.1), con el tratamiento de la version aprobada:
 * fijo arriba, fondo translucido con desenfoque y borde inferior sutil.
 *
 * Alturas 56px movil / 72px escritorio — NO TOCAR. El boceto usaba 64px; se
 * respeta la spec congelada en su lugar, porque scroll-padding-top y el FAB
 * dependen de esos dos valores.
 *
 * Sin menu hamburguesa (Fase 1 §8.1). En movil quedan el enlace al catalogo
 * y el boton Cotizar; las secciones completas aparecen desde 900px, que es
 * donde entran sin apretarse.
 *
 * "Cotizar" es un ancla a la seccion de cierre, no un enlace a WhatsApp: el
 * Bloque 2 de Fase 2.5 dejo la pagina con una jerarquia de CTA fija y un
 * boton de WhatsApp en el header competiria con el del medidor.
 *
 * El logo va con alt vacio a proposito: el enlace ya lleva aria-label, y un
 * alt con el mismo texto haria que el lector de pantalla lo anunciara dos
 * veces.
 */
import { Image } from 'astro:assets';
import logo from '../assets/logo-imprenta-escalante.png';
import { HAY_UBICACION, SETTINGS } from '../lib/settings';

const secciones = [
  { href: '#medir', texto: 'Medir', id: 'medir' },
  { href: '#catalogo', texto: 'Catálogo', id: 'catalogo' },
  { href: '#proceso', texto: 'Cómo trabajamos', id: 'proceso' },
  ...(HAY_UBICACION ? [{ href: '#ubicacion', texto: 'Ubicación', id: 'ubicacion' }] : []),
];
---

<header class="top">
  <div class="wrap top-in">
    <a href="#top" aria-label={`${SETTINGS.businessName} — inicio`} data-testid="logo-home-link" class="marca">
      <Image src={logo} alt="" width={800} height={165} widths={[160, 320]} sizes="160px" loading="eager" class="marca-img" />
    </a>

    <nav aria-label="Navegación principal" class="top-nav">
      {
        secciones.map((s) => (
          <a href={s.href} data-testid={`nav-${s.id}`} class:list={['top-link', s.id !== 'catalogo' && 'solo-ancho']}>
            {s.texto}
          </a>
        ))
      }
      <a href="#cotizar" data-testid="nav-cotizar" class="btn btn-ppal btn-sm">Cotizar</a>
    </nav>
  </div>
</header>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--surface-0) 86%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    /* Sombra interna y no border-bottom: el borde se sumaba a la altura y
       el header media 73px en vez de los 72 congelados. */
    box-shadow: inset 0 -1px 0 var(--border-subtle);
  }

  .top-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    height: var(--header-height-mobile);
  }

  .marca {
    display: flex;
    align-items: center;
    border-radius: var(--radius-sm);
  }

  .marca-img {
    height: 24px;
    width: auto;
  }

  .top-nav {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .top-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink-base);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: color var(--duration-fast) ease;
  }

  .top-link:hover {
    color: var(--ink-brand);
  }

  .solo-ancho {
    display: none;
  }

  @media (min-width: 768px) {
    .top-in {
      height: var(--header-height-desktop);
    }

    .marca-img {
      height: 32px;
    }
  }

  @media (min-width: 900px) {
    .solo-ancho {
      display: inline;
    }
  }
</style>
