---
/**
 * Seccion de pedido (ancla #pedido), con el tratamiento de la maqueta:
 * fondo naranja, titulo gigante con eco en contorno y una grilla de chips.
 *
 * DIFERENCIA DELIBERADA CON LA MAQUETA: alli los chips acompanan un
 * formulario con campos de nombre y mensaje. Aqui son ENLACES.
 *
 * El formulario esta prohibido por cuatro reglas a la vez:
 *   - "Sin formularios, sin captura de datos personales" (AGENTS 17, G-02)
 *   - "Los enlaces funcionan con JavaScript desactivado" (AGENTS 18, E-09);
 *     un mensaje armado desde campos exige JS
 *   - El formato del mensaje esta congelado (Fase 2.5 seccion 3.4)
 *   - La allowlist de service_id esta congelada en tres valores (seccion 3.5)
 *
 * Con enlaces se conserva lo que el chip aporta —elegir el producto de un
 * toque— sin romper ninguna: el service_id sale de la allowlist y la
 * etiqueta es un valor estatico tipado, no texto libre leido del DOM.
 */
import { CATALOGO } from '../data/catalogo';
import { CATEGORIAS } from '../data/catalogo';
import { SERVICES } from '../data/services';
import { buildWhatsappHref } from '../lib/whatsapp';

/** Cada pieza del catalogo hereda el service_id de su categoria. */
const servicioDe = (categoriaId: string) =>
  CATEGORIAS.find((c) => c.id === categoriaId)?.servicio ?? 'gran-formato';

const chips = CATALOGO.map((item) => {
  const servicio = servicioDe(item.categoria);
  const etiqueta = SERVICES.find((s) => s.id === servicio)?.label ?? item.titulo;
  return {
    id: item.id,
    titulo: item.titulo,
    // El label del mensaje combina el servicio de la allowlist con el nombre
    // del producto, ambos valores estaticos del repositorio.
    href: buildWhatsappHref(`${etiqueta} — ${item.titulo}`, servicio, 'catalog'),
  };
});

const hrefGeneral = buildWhatsappHref('Cotización general', 'general', 'catalog');
---

<section
  id="pedido"
  data-testid="pedido"
  class="bg-surface-brand py-space-8 md:py-space-10"
>
  <div class="mx-auto max-w-container px-space-2 md:px-space-6">
    {/* Titulo con eco en contorno, como en la maqueta. El eco es decorativo:
        se repite el texto solo para el ojo, nunca para el lector de pantalla. */}
    <div class="relative">
      <h2
        class="font-display text-h1 uppercase leading-none text-ink-on-brand md:text-h1-desktop"
      >
        Haz tu pedido
      </h2>
      <p
        aria-hidden="true"
        class="pedido-eco font-display text-h1 uppercase leading-none md:text-h1-desktop"
      >
        Cotiza
      </p>
    </div>

    <p class="mt-space-3 max-w-xl text-body text-ink-on-brand">
      Elige qué necesitas y se abre WhatsApp con el mensaje ya escrito. Tú solo
      agregas medidas, cantidad y para cuándo lo quieres.
    </p>

    <h3 class="mt-space-6 font-display text-h3 uppercase text-ink-on-brand">
      ¿Qué necesitas?
    </h3>

    <ul class="mt-space-3 flex flex-wrap gap-space-2">
      {
        chips.map((chip) =>
          chip.href ? (
            <li>
              <a
                href={chip.href}
                data-testid={`chip-${chip.id}`}
                data-wa-link
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-12 items-center rounded-full border-2 border-ink-on-brand px-space-2 text-small sm:px-space-3 font-semibold text-ink-on-brand transition-colors duration-base hover:bg-ink-on-brand hover:text-ink-strong focus-visible:outline-2 focus-visible:outline-offset-2"
              >
                {chip.titulo}
              </a>
            </li>
          ) : (
            <li>
              <span
                data-testid={`chip-${chip.id}`}
                aria-disabled="true"
                title="Configura PUBLIC_WHATSAPP_E164 para habilitar este enlace"
                class="inline-flex min-h-12 cursor-not-allowed items-center rounded-full border-2 border-dashed border-ink-on-brand px-space-2 text-small sm:px-space-3 font-semibold text-ink-on-brand opacity-70"
              >
                {chip.titulo}
              </span>
            </li>
          )
        )
      }
    </ul>

    <div class="mt-space-6">
      {
        hrefGeneral ? (
          <a
            href={hrefGeneral}
            data-testid="cta-pedido-general"
            data-wa-link
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-space-7 items-center justify-center rounded-full bg-surface-inverse px-space-4 font-display text-small uppercase tracking-wide text-ink-strong transition-colors duration-base hover:bg-surface-1 focus-visible:outline-2 focus-visible:outline-offset-2"
          >
            No está en la lista, quiero cotizar otra cosa
          </a>
        ) : (
          <span
            data-testid="cta-pedido-general"
            aria-disabled="true"
            class="inline-flex min-h-space-7 cursor-not-allowed items-center justify-center rounded-full border-2 border-dashed border-ink-on-brand px-space-4 font-display text-small uppercase text-ink-on-brand opacity-70"
          >
            Contacto no disponible
          </span>
        )
      }
    </div>
  </div>
</section>

<style>
  /* Eco en contorno: mismo tipo, solo trazo. -webkit-text-stroke es la via
     con soporte real; el color transparente deja ver el fondo naranja. */
  .pedido-eco {
    color: transparent;
    /* Trazo grueso: a 2px el eco se perdia contra el naranja. */
    -webkit-text-stroke: 4px var(--ink-onBrand);
    /* Cae por debajo del titulo en vez de encimarse, como en la maqueta. */
    margin-top: 0.04em;
  }
</style>
