---
/**
 * Caja gris con label — representa cualquier asset que todavia no existe
 * (logo, foto de servicio, icono). Nunca es un color literal: usa
 * --surface-2 / --border-hairline / --ink-muted de tokens.css.
 */
interface Props {
  label: string;
  /** Ej. "4/3", "1/1". Si no se define, la caja llena al contenedor padre. */
  ratio?: string;
  class?: string;
}

const { label, ratio, class: className = '' } = Astro.props;
---

<div
  role="img"
  aria-label={label}
  class:list={[
    'flex items-center justify-center border border-dashed p-space-1 text-center',
    className,
  ]}
  style={{
    backgroundColor: 'var(--surface-2)',
    borderColor: 'var(--border-hairline)',
    aspectRatio: ratio ?? undefined,
  }}
>
  <span class="text-[11px] font-medium uppercase tracking-wide" style={{ color: 'var(--ink-muted)' }}>
    {label}
  </span>
</div>
