---
/**
 * Caja con label — representa cualquier asset que todavia no existe
 * (logo, foto de servicio). Cero color literal: todo por clases mapeadas a
 * la capa semantica de tokens.css.
 *
 * Las relaciones de aspecto se resuelven con clases estaticas para que
 * Tailwind pueda detectarlas al escanear el proyecto.
 */
interface Props {
  label: string;
  /** Relacion de aspecto. "4/3" es la de las tarjetas de servicio (§8.4). */
  ratio?: '4/3' | '1/1';
  class?: string;
}

const { label, ratio, class: className = '' } = Astro.props;

const ratioClass = ratio === '4/3' ? 'aspect-[4/3]' : ratio === '1/1' ? 'aspect-square' : '';
---

<div
  role="img"
  aria-label={label}
  class:list={[
    'flex items-center justify-center rounded-sm border border-dashed border-line-hairline bg-surface-2 p-space-1 text-center',
    ratioClass,
    className,
  ]}
>
  <span class="text-x-small font-medium uppercase tracking-wide text-ink-muted">
    {label}
  </span>
</div>
