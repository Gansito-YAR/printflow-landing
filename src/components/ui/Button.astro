---
/**
 * CTA de la landing. Variantes: primary | secondary | disabled.
 * La variante "disabled" no se elige a mano: se activa sola cuando `href`
 * es null (spec §9.4 — falta PUBLIC_WHATSAPP_E164).
 *
 * Cuando `isWhatsapp` es true, el boton queda marcado con data-wa-link para
 * que src/lib/wa-cta-client.ts le agregue el comportamiento de
 * Loading/Error/target por viewport (progresivo: sin JS, el <a href> igual
 * navega).
 */
interface Props {
  variant?: 'primary' | 'secondary';
  href: string | null;
  label: string;
  testId: string;
  isWhatsapp?: boolean;
  size?: 'md' | 'lg';
  fullWidthMobile?: boolean;
  minWidthDesktop?: string;
  class?: string;
}

const {
  variant = 'primary',
  href,
  label,
  testId,
  isWhatsapp = false,
  size = 'md',
  fullWidthMobile = false,
  minWidthDesktop,
  class: className = '',
} = Astro.props;

const isDisabled = href === null;

const heightClass = size === 'lg' ? 'h-space-7' : 'h-12'; // 56px | 48px
const widthClass = fullWidthMobile ? 'w-full md:w-auto' : '';

const base =
  'inline-flex items-center justify-center gap-space-1 px-space-3 text-sm md:text-[15px] font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2';

const variantClass = isDisabled
  ? 'cursor-not-allowed border-2 border-dashed'
  : variant === 'primary'
    ? 'border-2 hover:bg-[var(--surface-2)]'
    : 'border-2 border-transparent underline-offset-4 hover:underline';
---

{
  isDisabled ? (
    <button
      type="button"
      disabled
      aria-disabled="true"
      data-testid={testId}
      class:list={[base, heightClass, widthClass, variantClass, className]}
      style={{
        borderColor: 'var(--border-hairline)',
        color: 'var(--ink-muted)',
        backgroundColor: 'var(--surface-1)',
      }}
      title="Configura PUBLIC_WHATSAPP_E164 para habilitar este enlace"
    >
      Contacto no disponible
    </button>
  ) : (
    <a
      id={testId}
      href={href}
      data-testid={testId}
      data-wa-link={isWhatsapp ? '' : undefined}
      class:list={[base, heightClass, widthClass, variantClass, className]}
      style={
        variant === 'primary'
          ? {
              borderColor: 'var(--border-strong)',
              color: 'var(--ink-strong)',
              backgroundColor: 'var(--surface-0)',
              minWidth: minWidthDesktop,
            }
          : {
              color: 'var(--ink-base)',
              minWidth: minWidthDesktop,
            }
      }
    >
      <span data-wa-label={isWhatsapp ? '' : undefined}>{label}</span>
    </a>
  )
}

{
  isWhatsapp && !isDisabled && (
    <div
      data-wa-error-panel-for={testId}
      hidden
      role="alert"
      class="mt-space-1 max-w-sm border p-space-2 text-sm"
      style={{ borderColor: 'var(--border-hairline)', backgroundColor: 'var(--surface-1)', color: 'var(--ink-base)' }}
    >
      <p>No pudimos abrir WhatsApp automáticamente. Copia el enlace y pégalo en tu navegador:</p>
      <p class="mt-space-1 break-all font-mono text-xs" style={{ color: 'var(--ink-strong)' }}>{href}</p>
      <button
        type="button"
        data-wa-error-dismiss
        class="mt-space-1 border px-space-1 py-space-1 text-xs"
        style={{ borderColor: 'var(--border-hairline)' }}
      >
        Cerrar
      </button>
    </div>
  )
}
