---
import PlaceholderBox from './ui/PlaceholderBox.astro';
import Button from './ui/Button.astro';
import type { Service } from '../data/services';
import { buildWhatsappHref } from '../lib/whatsapp';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const href = buildWhatsappHref(service.label, service.id, 'catalog');
---

<article
  class="flex flex-col border p-space-3"
  style={{ borderColor: 'var(--border-hairline)', backgroundColor: 'var(--surface-0)' }}
>
  <PlaceholderBox
    label="[IMAGEN SERVICIO 4:3 — PLACEHOLDER]"
    ratio="4/3"
    class="w-full"
  />

  <h3
    class="mt-space-3 text-lg font-semibold"
    style={{ color: 'var(--ink-strong)' }}
  >
    {service.label}
  </h3>

  <p
    class="mt-space-1 line-clamp-2 text-sm"
    style={{ color: 'var(--ink-base)' }}
  >
    {service.description}
  </p>

  <div class="mt-space-3">
    <Button
      variant="secondary"
      href={href}
      label={`Cotizar ${service.label}`}
      testId={`cta-card-${service.id}`}
      isWhatsapp
      fullWidthMobile
    />
  </div>
</article>
