---
/**
 * Una pieza del catalogo, con el tratamiento de la maqueta aprobada:
 * caption solida naranja alternando con caption negra de borde naranja.
 *
 * REGLA CENTRAL: la imagen se muestra COMPLETA, nunca recortada.
 *
 * La maqueta logra su orden visual con object-fit: cover sobre relaciones
 * fijas (16/9, 3/4, 21/8), o sea recortando: en la referencia se ve cortada
 * la lona amarilla y "Letras de acrilico". Aqui el orden sale de otro lado:
 * cada pieza ocupa un ancho de columna elegido segun su proporcion REAL, y
 * dentro de ese ancho la imagen se ve entera. Mismo ritmo editorial, sin
 * mutilar ninguna foto.
 */
import { Image } from 'astro:assets';
import type { ItemCatalogo } from '../data/catalogo';

interface Props {
  item: ItemCatalogo;
  /** Caption negra con borde naranja en vez de naranja solida. */
  oscura?: boolean;
  /** Las primeras piezas visibles cargan antes; el resto se difiere. */
  eager?: boolean;
}

const { item, oscura = false, eager = false } = Astro.props;
---

<figure
  class="flex flex-col overflow-hidden rounded-md"
  data-testid={`catalogo-item-${item.id}`}
>
  <Image
    src={item.image}
    alt={item.alt}
    width={item.width}
    height={item.height}
    widths={[320, 480, item.width]}
    sizes="(min-width: 1024px) 560px, (min-width: 640px) 48vw, 46vw"
    loading={eager ? 'eager' : 'lazy'}
    decoding={eager ? 'sync' : 'async'}
    class="h-auto w-full"
  />

  <figcaption
    class:list={[
      'flex flex-1 flex-col gap-space-1 px-space-2 py-space-2',
      oscura
        ? 'border-2 border-t-0 border-line-brand bg-surface-inverse text-ink-strong'
        : 'bg-surface-brand text-ink-on-brand',
    ]}
  >
    <h3 class="font-display text-h3 uppercase leading-none">{item.titulo}</h3>
    {item.descripcion && <p class="text-small leading-snug">{item.descripcion}</p>}
  </figcaption>
</figure>
