---
/**
 * Seccion de confianza (spec §8.5): politica de anticipos + proceso de 3
 * pasos + CTA final. Prohibido agregar sellos, testimonios, logos de
 * clientes o certificaciones — no existen en las fuentes.
 *
 * Fase 2.5 §2.2 — Se retiro el CTA final de esta seccion. Quedaba a menos de
 * 200px del FAB flotante, mandaba el mismo mensaje generico y era el cuarto
 * "Cotizacion general" de la pagina. El FAB cubre esa zona.
 */
import ProcessSteps from './ProcessSteps.astro';
---

<section
  data-testid="trust"
  class="mx-auto max-w-container px-space-2 py-space-6 md:px-space-6 md:py-space-8"
>
  <h2 class="font-display text-h2 uppercase text-ink-strong md:text-h2-desktop">
    Cómo trabajamos
  </h2>

  <p
    class="mt-space-3 max-w-2xl rounded-sm border-l-4 border-line-brand bg-surface-1 p-space-2 text-body text-ink-base"
  >
    Los pedidos personalizados requieren un anticipo del 50% para iniciar producción. El
    saldo restante debe quedar liquidado antes de la entrega.
  </p>

  <div class="mt-space-6">
    <ProcessSteps />
  </div>
</section>
