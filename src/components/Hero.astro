---
/**
 * Hero (spec §8.2). Estructura intocable: desktop texto en columnas 1-7 y
 * visual en 8-12; mobile H1 -> apoyo -> CTA -> visual, en ese orden.
 */
import PlaceholderBox from './ui/PlaceholderBox.astro';
import Button from './ui/Button.astro';
import { buildWhatsappHref } from '../lib/whatsapp';

const href = buildWhatsappHref('Cotización general', 'general', 'hero');
---

<section
  data-testid="hero"
  class="mx-auto max-w-container px-space-2 py-space-6 md:grid md:grid-cols-12 md:items-center md:gap-space-3 md:px-space-6 md:py-space-8"
>
  <div class="flex flex-col gap-space-3 md:col-span-7">
    <h1 class="font-display text-h1 uppercase text-ink-strong md:text-h1-desktop">
      Cotiza tus impresos por WhatsApp y da seguimiento a tu pedido
    </h1>

    <p class="max-w-xl text-body text-ink-base md:text-body-lg">
      Lonas, viniles, papelería comercial y promocionales para menudeo y mayoreo.
    </p>

    <div class="flex flex-col gap-space-2 sm:flex-row sm:items-center">
      <Button
        variant="primary"
        href={href}
        label="Cotizar por WhatsApp"
        testId="cta-hero-whatsapp"
        isWhatsapp
        size="lg"
        fullWidthMobile
        wideDesktop
      />
      <Button
        variant="secondary"
        href="#servicios"
        label="Ver servicios"
        testId="cta-hero-ver-servicios"
        fullWidthMobile
      />
    </div>
  </div>

  <div class="mt-space-4 md:col-span-5 md:mt-0">
    <PlaceholderBox label="[IMAGEN HERO — PLACEHOLDER]" ratio="4/3" class="w-full" />
  </div>
</section>
